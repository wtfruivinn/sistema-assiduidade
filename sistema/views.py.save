from django.shortcuts import render, redirect, get_object_or_404
from django.contrib.auth import authenticate, login, logout
from django.contrib.auth.decorators import login_required
from django.contrib import messages
from django.http import JsonResponse
from django.views.decorators.http import require_POST
from .models import Aula, Docente, Presenca, ValidacaoAula, HorasDocente
from datetime import datetime
from geopy.distance import geodesic


def pagina_login(request):
    if request.user.is_authenticated:
        return redirect("painel")

    if request.method == "POST":
        username = request.POST.get("username")
        password = request.POST.get("password")
        user = authenticate(request, username=username, password=password)

        if user is not None:
            login(request, user)
            messages.success(request, f"Bem-vindo, {user.username}!")
            return redirect("painel")
        else:
            return render(request, "sistema/login.html", {
                "erro": "Utilizador ou palavra-passe incorretos."
            })

    return render(request, "sistema/login.html")


def pagina_logout(request):
    logout(request)
    messages.info(request, "Sessão terminada com sucesso.")
    return redirect("login")


def pagina_inicial(request):
    if request.user.is_authenticated:
        return redirect("painel")
    return redirect("login")


@login_required(login_url="login")
def painel_docente(request):
    try:
        docente = Docente.objects.get(user=request.user)
    except Docente.DoesNotExist:
        docente = None

    if docente:
        aulas = Aula.objects.filter(docente=docente).order_by("-data", "-hora_inicio")
    else:
        aulas = Aula.objects.all().order_by("-data", "-hora_inicio")

    total_aulas = aulas.count()
    aulas_validadas = aulas.filter(estado="validada").count()
    aulas_agendadas = aulas.filter(estado="agendada").count()

    context = {
        "docente": docente,
        "aulas": aulas,
        "total_aulas": total_aulas,
        "aulas_validadas": aulas_validadas,
        "aulas_agendadas": aulas_agendadas,
    }
    return render(request, "sistema/painel.html", context)


@login_required(login_url="login")
def detalhe_aula(request, aula_id):
    """Página de detalhe da aula — iniciar, validar local, registar presenças, encerrar"""
    aula = get_object_or_404(Aula, id=aula_id)

    # Presenças já registadas (se existirem)
    presencas = Presenca.objects.filter(aula=aula)

    # Estudantes da turma
    from .models import Inscricao
    inscricoes = Inscricao.objects.filter(turma=aula.turma)
    estudantes = [i.estudante for i in inscricoes]

    # Última validação (se existir)
    validacao = ValidacaoAula.objects.filter(aula=aula).order_by("-data_hora").first()

    context = {
        "aula": aula,
        "estudantes": estudantes,
        "presencas": presencas,
        "validacao": validacao,
    }
    return render(request, "sistema/aula_detalhe.html", context)


# ============================================================
# ENDPOINTS AJAX (chamados pelo JavaScript do frontend)
# ============================================================

@login_required(login_url="login")
@require_POST
def api_iniciar_aula(request, aula_id):
    """Inicia a aula — estado passa a 'em_curso'"""
    aula = get_object_or_404(Aula, id=aula_id)

    if aula.estado not in ["agendada", "em_curso"]:
        return JsonResponse({"erro": "A aula não pode ser iniciada neste estado."}, status=400)

    aula.estado = "em_curso"
    aula.hora_inicio_real = datetime.now().time()
    aula.save()

    return JsonResponse({
        "sucesso": True,
        "mensagem": "Aula iniciada. Valide agora a sua localização.",
        "estado": aula.estado,
    })


@login_required(login_url="login")
@require_POST
def api_validar_local(request, aula_id):
    """Valida se o docente está na sala correta (GPS + QR + Wi-Fi)"""
    aula = get_object_or_404(Aula, id=aula_id)
    sala = aula.sala

    latitude = request.POST.get("latitude")
    longitude = request.POST.get("longitude")
    qr_lido = request.POST.get("qr_code", "")
    wifi_ssid = request.POST.get("wifi_ssid", "")

    sala_validada = False
    recinto_validado = False
    qr_validado = False
    resultado = "bloqueado"
    mensagem = ""

    # 1. Validação por QR Code
    if qr_lido and qr_lido == sala.qr_code:
        qr_validado = True
        sala_validada = True
        recinto_validado = True
        resultado = "autorizado"
        mensagem = "QR Code validado com sucesso."

    # 2. Validação por Wi-Fi SSID
    elif wifi_ssid and wifi_ssid == sala.wifi_ssid:
        sala_validada = True
        recinto_validado = True
        resultado = "autorizado"
        mensagem = f"Rede Wi-Fi '{wifi_ssid}' corresponde à sala."

    # 3. Validação por GPS
    elif latitude and longitude and sala.latitude and sala.longitude:
        try:
            ponto_docente = (float(latitude), float(longitude))
            ponto_sala = (float(sala.latitude), float(sala.longitude))
            distancia = geodesic(ponto_docente, ponto_sala).meters

            if distancia <= 30:
                recinto_validado = True
                sala_validada = True
                resultado = "autorizado"
                mensagem = f"Localização validada. Distância: {distancia:.1f}m"
            elif distancia <= 100:
                recinto_validado = True
                mensagem = f"Está no recinto, mas a {distancia:.1f}m da sala. Aproxime-se."
            else:
                mensagem = f"Está a {distancia:.1f}m da sala. Aula bloqueada."
        except (ValueError, TypeError):
            mensagem = "Coordenadas GPS inválidas."
    else:
        mensagem = "Nenhum método de validação foi detetado."

    # Registar a validação
    ValidacaoAula.objects.create(
        aula=aula,
        docente=aula.docente,
        latitude=latitude or None,
        longitude=longitude or None,
        sala_validada=sala_validada,
        recinto_validado=recinto_validado,
        horario_validado=True,
        qr_validado=qr_validado,
        resultado=resultado,
    )

    if resultado == "autorizado":
        return JsonResponse({
            "sucesso": True,
            "resultado": "autorizado",
            "mensagem": mensagem,
            "sala_validada": True,
            "recinto_validado": True,
        })
    else:
        return JsonResponse({
            "sucesso": False,
            "resultado": "bloqueado",
            "mensagem": mensagem,
            "sala_validada": sala_validada,
            "recinto_validado": recinto_validado,
        }, status=403)


@login_required(login_url="login")
@require_POST
def api_registar_presencas(request, aula_id):
    """Regista presenças dos estudantes"""
    aula = get_object_or_404(Aula, id=aula_id)

    presencas_guardadas = 0
    for key, valor in request.POST.items():
        if key.startswith("estudante_"):
            estudante_id = key.replace("estudante_", "")
            Presenca.objects.update_or_creat                aula=aula,
                estudante_id=estudante_id,
                defaults={"estado": valor},
            )
            presencas_guardadas += 1

    return JsonResponse({
        "sucesso": True,
        "mensagem": f"{presencas_guardadas} presenças registadas.",
        "total": presencas_guardadas,
    })


@login_required(login_url="login")
@require_POST
def api_encerrar_aula(request, aula_id):
    """Encerra a aula, calcula horas e valor a pagar"""
    aula = get_object_or_404(Aula, id=aula_id)

    if aula.estado != "em_curso":
        return JsonResponse({"erro": "A aula não está em curso."}, status=400)

    sumario = request.POST.get("sumario", "").strip()
    tema = request.POST.get("tema", "").strip()

    if not sumario or not tema:
        return JsonResponse({"erro": "Sumário e tema são obrigatórios."}, status=400)

    if not aula.presencas.exists():
        return JsonResponse({"erro": "Registe as presenças antes de encerrar."}, status=400)

    # Encerrar
    aula.sumario = sumario
    aula.tema = tema
    aula.hora_fim_real = datetime.now().time()
    aula.estado = "validada"
    aula.save()

    # Calcular horas
    h_inicio = aula.hora_inicio_real or aula.hora_inicio
    h_fim = aula.hora_fim_real or aula.hora_fim
    dt_inicio = datetime.combine(aula.data, h_inicio)
    dt_fim = datetime.combine(aula.data, h_fim)
    horas = round((dt_fim - dt_inicio).total_seconds() / 3600, 2)

    valor_hora = aula.docente.categoria.valor_hora
    valor_total = horas * valor_hora

    # Registar horas (update_or_create evita duplicação — RN10)
    HorasDocente.objects.update_or_create(
        aula=aula,
        defaults={
            "docente": aula.docente,
            "data": aula.data,
            "horas": horas,
            "valor_hora": valor_hora,
            "valor_total": valor_total,
            "estado": "validada",
        }
    )

    return JsonResponse({
        "sucesso": True,
        "mensagem": "Aula encerrada e validada com sucesso!",
        "horas": float(horas),
        "valor_hora": float(valor_hora),
        "valor_total": float(valor_total),
    })
